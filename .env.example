# Copy this file to .env.local for your Mac, or add the same names in Vercel → Settings → Environment Variables.
# The AI help (word meanings, page summaries, grammar and speaking feedback) needs at least one key.
# If you add more than one, the app tries them in this order and moves on when one runs out of free requests.

# Paid. Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Free. Just a Google account, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Free backup, no card: https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Any other service that uses the OpenAI API format (OpenRouter, Cerebras, a local server). Set all three.
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=
# AI_MODEL=

# Recommended once the site is online, so nobody else can use up your free requests.
# APP_PASSWORD=

# Sync between your Mac and phone. In Vercel: Storage → Create Database → Upstash for Redis → connect.
# Vercel fills these in for you; only set them by hand when running on your Mac.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
