# Copy this file to .env.local and fill in the values.

# Claude API key from https://console.anthropic.com (separate from a Claude Pro subscription).
# Turns on word explanations, page summaries, grammar and speaking feedback.
ANTHROPIC_API_KEY=

# Optional: which Claude model the coach uses. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# Optional but recommended once the site is online: a password so other people can't use your API credits.
# APP_PASSWORD=
