":"IV","p":189,"l":4},{"t":"V","p":190,"l":4},{"t":"VI","p":193,"l":4},{"t":"VII","p":194,"l":4},{"t":"VIII","p":197,"l":4},{"t":"IX","p":200,"l":4},{"t":"X","p":203,"l":4},{"t":"XI","p":204,"l":4},{"t":"XII","p":206,"l":4},{"t":"XIII","p":210,"l":4},{"t":"Book VII","p":213,"l":2},{"t":"Characters Other Than Virtue and Vice","p":213,"l":3},{"t":"I","p":213,"l":4},{"t":"II","p":216,"l":4},{"t":"III","p":219,"l":4},{"t":"IV","p":225,"l":4},{"t":"V","p":229,"l":4},{"t":"VI","p":232,"l":4},{"t":"VII","p":236,"l":4},{"t":"VIII","p":239,"l":4},{"t":"IX","p":241,"l":4},{"t":"X","p":244,"l":4},{"t":"Of Pleasure","p":246,"l":3},{"t":"XI","p":246,"l":4},{"t":"XII","p":247,"l":4},{"t":"XIII","p":250,"l":4},{"t":"XIV","p":253,"l":4},{"t":"Book VIII","p":257,"l":2},{"t":"Friendship or Love","p":257,"l":3},{"t":"I","p":257,"l":4},{"t":"II","p":260,"l":4},{"t":"III","p":262,"l":4},{"t":"IV","p":266,"l":4},{"t":"V","p":268,"l":4},{"t":"VI","p":270,"l":4},{"t":"VII","p":273,"l":4},{"t":"VIII","p":275,"l":4},{"t":"IX","p":278,"l":4},{"t":"X","p":280,"l":4},{"t":"XI","p":283,"l":4},{"t":"XII","p":285,"l":4},{"t":"XIII","p":289,"l":4},{"t":"XIV","p":293,"l":4},{"t":"Book IX","p":296,"l":2},{"t":"Friendship or Love—Continued","p":296,"l":3},{"t":"I","p":296,"l":4},{"t":"II","p":300,"l":4},{"t":"III","p":303,"l":4},{"t":"IV","p":305,"l":4},{"t":"V","p":309,"l":4},{"t":"VI","p":311,"l":4},{"t":"VII","p":313,"l":4},{"t":"VIII","p":316,"l":4},{"t":"IX","p":321,"l":4},{"t":"X","p":326,"l":4},{"t":"XI","p":328,"l":4},{"t":"XII","p":331,"l":4},{"t":"Book X","p":332,"l":2},{"t":"Pleasure","p":332,"l":3},{"t":"I","p":332,"l":4},{"t":"II","p":334,"l":4},{"t":"III","p":337,"l":4},{"t":"IV","p":341,"l":4},{"t":"V","p":346,"l":4},{"t":"Conclusion","p":351,"l":3},{"t":"VI","p":351,"l":4},{"t":"VII","p":354,"l":4},{"t":"VIII","p":358,"l":4},{"t":"IX","p":363,"l":4}],"description":["Aristotle examines how best to live by looking at the nature of those virtues that characterize the most thriving human beings, and then at how to acquire and develop such virtues. This book is considered the founding document of what is now known as the “virtue ethics” tradition.","Along the way, Aristotle delves into pleasure, happiness, justice, friendship, and willpower. He intended the Nicomachean Ethics to be the foundation on which to build his Politics.","Nicomachean Ethics is based on Aristotle’s lectures at the Lyceum and was originally collected as a series of ten scrolls. In translation it was hugely influential in the development of Western philosophic tradition, quickly becoming one of the core works of medieval philosophy."]}